      "overrides": {
        "activate_key_table": {
          "status": "supported",
          "note": "Activates a named table in the current pane with Ghostty's duplicate-top and maximum-depth rules."
        },
        "activate_key_table_once": {
          "status": "supported",
          "note": "Activates a pane-local one-shot table and pops it when the innermost table supplies a match."
        },
        "check_for_updates": {
          "status": "not_applicable",
          "scope": "macos"
        },
        "close_all_windows": {
          "status": "not_applicable",
          "scope": "linux",
          "note": "Deprecated upstream and intentionally a no-op on Linux."
        },
        "close_surface": {
          "status": "partial",
          "note": "Local root triggers route pane close through the typed workspace dispatcher and Ghostty action catalog."
        },
        "close_tab": {
          "status": "partial",
          "note": "Local root triggers support the default/this mode; other/right tab modes remain planned."
        },
        "close_window": {
          "status": "partial",
          "note": "The current single-window application maps this action to its confirmed quit path; multiwindow semantics remain planned."
        },
        "copy_to_clipboard": {
          "status": "partial",
          "note": "Configured plain/mixed copy routes to selection copy; styled VT and HTML formats remain absent."
        },
        "decrease_font_size": {
          "status": "partial"
        },
        "deactivate_all_key_tables": {
          "status": "supported"
        },
        "deactivate_key_table": {
          "status": "supported"
        },
        "end_key_sequence": {
          "status": "partial",
          "note": "Root and named-table sequences flush their staged leaders; a normally consumed binding suppresses its terminator while an explicitly unconsumed binding encodes it."
        },
        "goto_split": {
          "status": "partial",
          "note": "Local root triggers and the action catalog support cardinal directions and legacy top/bottom aliases; previous/next remain absent."
        },
        "increase_font_size": {
          "status": "partial"
        },
        "ignore": {
          "status": "partial",
          "note": "Root and named-table bindings suppress VT encoding with Ghostty consume and catch-all invalid-sequence semantics; all/global dispatch ignores local consumption flags."
        },
        "inspector": {
