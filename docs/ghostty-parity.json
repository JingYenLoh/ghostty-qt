  "scope": {
    "host_os": [
      "linux"
    ],
    "display_servers": [
      "wayland"
    ],
    "toolkit": "qt-quick",
    "shared_config": {
      "enabled": true,
      "format": "ghostty",
      "policy": "Portable and Linux Ghostty keys retain upstream names and semantics."
    },
    "toolkit_mapping_policy": "Meaningful GTK frontend behavior maps to Qt; GTK presentation and debugging internals are not applicable.",
    "excluded_platforms": [
      "freebsd",
      "ios",
      "macos",
      "x11"
    ]
  },
  "status_definitions": {
    "supported": "Upstream-compatible behavior is implemented and tested.",
    "partial": "Some behavior exists, but the upstream interface or semantics are incomplete.",
    "planned": "The item is in scope but is not implemented yet.",
    "blocked_upstream": "Implementation requires a missing stable libghostty-vt capability.",
    "not_applicable": "The item is outside the Linux/Wayland/Qt parity target."
  },
  "scope_definitions": {
    "portable": "Platform-neutral Ghostty behavior.",
    "linux": "Linux behavior independent of the display server.",
    "wayland": "Linux Wayland behavior.",
    "qt_mapping": "GTK-facing behavior with a meaningful Qt equivalent.",
    "gtk_only": "GTK implementation detail without a Qt parity requirement.",
    "macos": "macOS-only behavior.",
    "x11": "X11-only behavior."
  },
