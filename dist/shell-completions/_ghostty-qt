#compdef ghostty-qt
# Generated by scripts/generate-shell-completions.py; do not edit.

_ghostty_qt_fonts() {
  local -a fonts
  fonts=("${(@f)$(ghostty-qt +list-fonts 2>/dev/null | grep '^[A-Z]')}")
  _describe -t fonts 'font family' fonts
}

_ghostty_qt_directories() {
  _alternative 'special:special directory:(home inherit)' 'directories:directory:_directories'
}

_ghostty_qt() {
  local context state state_descr line
  typeset -A opt_args
  local -a actions
  actions=(
    "+version:Show pinned Ghostty build information"
    "+help:Show help for a pinned Ghostty action"
    "+list-fonts:List fonts visible to the pinned Ghostty helper"
    "+list-keybinds:List configured Ghostty keybindings"
    "+list-themes:List Ghostty themes"
    "+list-colors:List the configured terminal palette"
    "+list-actions:List Ghostty keybinding actions"
    "+ssh:Run SSH with Ghostty integration"
    "+ssh-cache:Manage the Ghostty SSH integration cache"
    "+edit-config:Open the preferred Ghostty configuration file"
    "+show-config:Print finalized Ghostty configuration"
    "+explain-config:Explain a Ghostty option or keybinding action"
    "+validate-config:Validate Ghostty configuration"
    "+show-face:Show the font face selected for text"
    "+crash-report:Show the newest Ghostty crash report"
    "+boo:Run Ghostty's interactive animation"
    "+new-window:Open a new window through application IPC"
    "+new-tab:Open a new tab through application IPC"
    "+toggle-quick-terminal:Toggle the quick terminal through application IPC"
  )

  _arguments -C \
    "-h[Show command-line help]" \
    "--help[Show command-line help]" \
    "-v[Show ghostty-qt version information]" \
    "--version[Show ghostty-qt version information]" \
    "--working-directory=[Start the command in this directory]:directory:_ghostty_qt_directories" \
    "--title=[Set the initial terminal title]:title:" \
    "--font-family=[Use this terminal font family]:family:_ghostty_qt_fonts" \
    "--font-size=[Set the terminal font size]:points:" \
    "--class=[Use this application and single-instance identity]:application-id:" \
    "--config-default-files=[Load Ghostty's standard configuration files]:boolean:(true false)" \
    "--scrollback-lines=[Estimate scrollback capacity in rows]:lines:" \
    "--hold[Keep the pane after the command exits]" \
    "--wait-after-command[Wait for a key press after the command exits]" \
    "--single-instance=[Select process uniqueness behavior]:mode:(false true detect)" \
    "--initial-window=[Request an initial window]:boolean:(true false)" \
    "-e[Run a command with all remaining arguments]:program:_command_names" \
    "1:action:->actions" \
    "*::argument:->arguments"

  case $state in
    (actions)
      _describe -t actions 'Ghostty action' actions
      ;;
    (arguments)
      case $words[2] in
        (+version)
          _arguments \
            "--help[Show help for this action]" \
            "*:argument:_default"
          ;;
        (+help)
          _arguments \
            "--help[Show help for this action]" \
            "*:argument:_default"
          ;;
        (+list-fonts)
          _arguments \
            "--family=[Filter by font family]:family:_ghostty_qt_fonts" \
            "--style=[Filter by font style name]:style-name:" \
            "--bold[Require a bold font]" \
            "--italic[Require an italic font]" \
            "--help[Show help for this action]" \
            "*:argument:_default"
          ;;
        (+list-keybinds)
          _arguments \
            "--default[Show default keybindings]" \
            "--docs[Include action documentation]" \
            "--plain[Disable terminal formatting]" \
            "--help[Show help for this action]" \
            "*:argument:_default"
          ;;
        (+list-themes)
          _arguments \
            "--path[Print each theme's full path]" \
            "--plain[Force plain output]" \
            "--color=[Filter by color scheme]:scheme:(all dark light)" \
            "--help[Show help for this action]" \
            "*:argument:_default"
          ;;
        (+list-colors)
          _arguments \
            "--plain[Disable terminal formatting]" \
            "--help[Show help for this action]" \
            "*:argument:_default"
          ;;
        (+list-actions)
          _arguments \
            "--docs[Include action documentation]" \
            "--help[Show help for this action]" \
            "*:argument:_default"
          ;;
        (+ssh)
          _arguments \
            "--forward-env[Forward configured environment variables]" \
            "--terminfo[Install xterm-ghostty terminfo remotely]" \
            "--cache[Use the SSH integration cache]" \
            "--ssh=[Select the wrapped SSH executable]:program:_command_names" \
            "--verbose[Print verbose diagnostics]" \
            "--help[Show help for this action]" \
            "*:SSH argument:_ssh"
          ;;
        (+ssh-cache)
          _arguments \
            "--clear[Clear the cache]" \
            "--add=[Add or update a cached host]:host:" \
            "--remove=[Remove a cached host]:host:" \
            "--prune=[Remove entries older than a duration]:duration:" \
            "--help[Show help for this action]" \
            "*:argument:_default"
          ;;
        (+edit-config)
          _arguments \
            "--help[Show help for this action]" \
            "*:argument:_default"
          ;;
        (+show-config)
          _arguments \
            "--default[Show defaults without user configuration]" \
            "--changes-only[Show only values changed from defaults]" \
            "--docs[Include configuration documentation]" \
            "--no-pager[Disable automatic paging]" \
            "--help[Show help for this action]" \
            "*:argument:_default"
          ;;
        (+explain-config)
          _arguments \
            "--option=[Explain a configuration option]:config-key:" \
            "--keybind=[Explain a keybinding action]:action:" \
            "--help[Show help for this action]" \
            "*:argument:_default"
          ;;
        (+validate-config)
          _arguments \
            "--config-file=[Validate this configuration file]:path:_files" \
            "--help[Show help for this action]" \
            "*:argument:_default"
          ;;
        (+show-face)
          _arguments \
            "--cp=[Look up a Unicode codepoint]:codepoint:" \
            "--string=[Look up every codepoint in text]:text:" \
            "--style=[Select the font style]:style:(regular bold italic bold_italic)" \
            "--presentation=[Force text or emoji presentation]:presentation:(text emoji)" \
            "--help[Show help for this action]" \
            "*:argument:_default"
          ;;
        (+crash-report)
          _arguments \
            "--help[Show help for this action]" \
            "*:argument:_default"
          ;;
        (+boo)
          _arguments \
            "--help[Show help for this action]" \
            "*:argument:_default"
          ;;
        (+new-window)
          _arguments \
            "--class=[Target a custom application instance]:application-id:" \
            "--working-directory=[Set the first pane's working directory]:directory:_ghostty_qt_directories" \
            "--command=[Set the first pane's command]:command:" \
            "--shell-integration=[Select shell integration for the first pane]:mode:(none detect bash elvish fish nushell zsh)" \
            "--title=[Set the first pane's title]:title:" \
            "-e[Run a command in the first pane]:program:_command_names" \
            "--help[Show help for this action]" \
            "*::command argument:_normal"
          ;;
        (+new-tab)
          _arguments \
            "--class=[Target a custom application instance]:application-id:" \
            "--surface-id=[Select the target surface]:surface-id:" \
            "--working-directory=[Set the new tab's working directory]:directory:_ghostty_qt_directories" \
            "--command=[Set the new tab's command]:command:" \
            "--shell-integration=[Select shell integration for the new tab]:mode:(none detect bash elvish fish nushell zsh)" \
            "--title=[Set the new tab's title]:title:" \
            "-e[Run a command in the new tab]:program:_command_names" \
            "--help[Show help for this action]" \
            "*::command argument:_normal"
          ;;
        (+toggle-quick-terminal)
          _arguments \
            "--class=[Select a custom application instance]:application-id:" \
            "--help[Show help for this action]" \
            "*:argument:_default"
          ;;
        (*) _normal ;;
      esac
      ;;
  esac
}

_ghostty_qt "$@"
